  <diagram id="change-flow" name="2. Access change flow">
    <mxGraphModel dx="1300" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="&lt;b style=&quot;font-size:16px&quot;&gt;How access changes: Git is the only path to IAM&lt;/b&gt;" style="text;html=1;align=left;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="30" as="geometry" />
        </mxCell>

        <mxCell id="a" value="&lt;b&gt;1. Create branch&lt;/b&gt;&lt;br&gt;feat/onboard-{user}&lt;br&gt;edit the template" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1E88E5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b" value="&lt;b&gt;2. Open pull request&lt;/b&gt;&lt;br&gt;who needs access, why,&lt;br&gt;ApprovedBy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1E88E5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="280" y="80" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c" value="&lt;b&gt;3. GitSync comments&lt;/b&gt;&lt;br&gt;the planned change set&lt;br&gt;on the PR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#E7157B;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="520" y="80" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="d" value="Head of Security&lt;br&gt;approves?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="65" width="160" height="100" as="geometry" />
        </mxCell>
        <mxCell id="e" value="&lt;b&gt;4. Squash-merge&lt;/b&gt;&lt;br&gt;to main" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1E88E5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1000" y="80" width="180" height="70" as="geometry" />
        </mxCell>

        <mxCell id="f" value="&lt;b&gt;5. GitSync detects&lt;/b&gt;&lt;br&gt;the new commit on main" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#E7157B;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1000" y="300" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="g" value="&lt;b&gt;6. Change set runs&lt;/b&gt;&lt;br&gt;as onward-cfn-deploy-role" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#E7157B;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="760" y="300" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="h" value="&lt;b&gt;7. Resources updated&lt;/b&gt;&lt;br&gt;IAM, Secrets Manager,&lt;br&gt;CloudTrail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#DD344C;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="520" y="300" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="i" value="&lt;b&gt;8. Verify&lt;/b&gt;&lt;br&gt;drift detection +&lt;br&gt;scripts/evidence.sh" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#43A047;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="280" y="300" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="j" value="&lt;b&gt;Audit answer&lt;/b&gt;&lt;br&gt;Git commit + PR approval&lt;br&gt;ApprovedBy tag&lt;br&gt;CloudTrail event" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#43A047;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="290" width="180" height="90" as="geometry" />
        </mxCell>

        <mxCell id="ab" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;" edge="1" parent="1" source="a" target="b"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="bc" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;" edge="1" parent="1" source="b" target="c"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="cd" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;" edge="1" parent="1" source="c" target="d"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="de" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#43A047;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d" target="e"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="da" value="No: revise" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="d" target="a">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="840" y="230" /><mxPoint x="130" y="230" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="ef" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;" edge="1" parent="1" source="e" target="f"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fg" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;" edge="1" parent="1" source="f" target="g"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="gh" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;" edge="1" parent="1" source="g" target="h"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="hi" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;" edge="1" parent="1" source="h" target="i"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ij" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;" edge="1" parent="1" source="i" target="j"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="note" value="Nobody changes IAM in the console. Drift detection flags any change made outside this flow, and CloudTrail records who made it." style="text;html=1;align=left;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="700" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="permission-decision" name="3. On-call permission decision">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="980" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="&lt;b style=&quot;font-size:16px&quot;&gt;Why ec2-user-2 can never create compute&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#545B64&quot;&gt;IAM policy evaluation for one request&lt;/span&gt;" style="text;html=1;align=left;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="600" height="45" as="geometry" />
        </mxCell>

        <mxCell id="start" value="ec2-user-2 requests&lt;br&gt;&lt;b&gt;ec2:RunInstances&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#546E7A;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="70" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="q1" value="Explicit Deny in any&lt;br&gt;policy or the boundary?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="290" y="170" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="q2" value="Allowed by an identity policy?&lt;br&gt;(group or user)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="290" y="340" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="q3" value="Allowed by the&lt;br&gt;permissions boundary?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="290" y="510" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="allow" value="&lt;b&gt;ALLOWED&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#43A047;fontSize=13;fontColor=#1B5E20;" vertex="1" parent="1">
          <mxGeometry x="330" y="680" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="deny1" value="&lt;b&gt;DENIED&lt;/b&gt;&lt;br&gt;boundary statement&lt;br&gt;NeverCreateOrTerminateCompute" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;fontSize=11;fontColor=#B71C1C;" vertex="1" parent="1">
          <mxGeometry x="670" y="195" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="deny2" value="&lt;b&gt;DENIED&lt;/b&gt;&lt;br&gt;implicit deny" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;fontSize=11;fontColor=#B71C1C;" vertex="1" parent="1">
          <mxGeometry x="670" y="365" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="deny3" value="&lt;b&gt;DENIED&lt;/b&gt;&lt;br&gt;outside the ceiling" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;fontSize=11;fontColor=#B71C1C;" vertex="1" parent="1">
          <mxGeometry x="670" y="535" width="240" height="70" as="geometry" />
        </mxCell>

        <mxCell id="s1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;" edge="1" parent="1" source="start" target="q1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="y1" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#C62828;strokeWidth=2;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="q1" target="deny1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="n1" value="No" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="q1" target="q2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="n2" value="No" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="q2" target="deny2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="y2" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="q2" target="q3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="n3" value="No" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="q3" target="deny3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="y3" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#43A047;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="q3" target="allow"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="note1" value="&lt;b&gt;ec2:RunInstances&lt;/b&gt; always stops here for ec2-user-2, even after AdministratorAccess is attached to the user or group (tamper test: evidence.sh -t)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#BDBDBD;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="185" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="note2" value="&lt;b&gt;ec2:DescribeInstances&lt;/b&gt; is allowed by AmazonEC2ReadOnlyAccess and by the boundary, so it reaches ALLOWED." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#BDBDBD;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="525" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="l1" style="html=1;endArrow=none;dashed=1;strokeColor=#BDBDBD;" edge="1" parent="1" source="note1" target="q1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="l2" style="html=1;endArrow=none;dashed=1;strokeColor=#BDBDBD;" edge="1" parent="1" source="note2" target="q3"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="first-login" name="4. Secure first sign-in">
    <mxGraphModel dx="1200" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="480" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="&lt;b style=&quot;font-size:16px&quot;&gt;Secure first sign-in: no shared plain-text password&lt;/b&gt;" style="text;html=1;align=left;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="30" as="geometry" />
        </mxCell>

        <mxCell id="p1" value="&lt;b&gt;1. Secret created&lt;/b&gt;&lt;br&gt;onward/onboarding/{user}&lt;br&gt;generated, 24 characters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#DD344C;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="&lt;b&gt;2. Login profile&lt;/b&gt;&lt;br&gt;reads it by dynamic reference;&lt;br&gt;never in Git or stack outputs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#E7157B;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="80" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="&lt;b&gt;3. Reset required&lt;/b&gt;&lt;br&gt;PasswordResetRequired = true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#E7157B;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="80" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="&lt;b&gt;4. Admin retrieves&lt;/b&gt;&lt;br&gt;in CloudShell with&lt;br&gt;get-secret-value" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1E88E5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="820" y="80" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p5" value="&lt;b&gt;5. Hand over privately&lt;/b&gt;&lt;br&gt;one engineer at a time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1E88E5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="820" y="260" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p6" value="&lt;b&gt;6. Engineer signs in&lt;/b&gt;&lt;br&gt;account sign-in URL&lt;br&gt;with username + password" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1E88E5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="260" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p7" value="&lt;b&gt;7. Sets a new password&lt;/b&gt;&lt;br&gt;iam:ChangePassword is&lt;br&gt;allowed by the boundary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="260" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p8" value="&lt;b&gt;8. Day-one access&lt;/b&gt;&lt;br&gt;from the group,&lt;br&gt;capped by the boundary" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#43A047;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="255" width="200" height="90" as="geometry" />
        </mxCell>

        <mxCell id="x1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="x2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="x3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;" edge="1" parent="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="x4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;" edge="1" parent="1" source="p4" target="p5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="x5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;" edge="1" parent="1" source="p5" target="p6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="x6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;" edge="1" parent="1" source="p6" target="p7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="x7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;" edge="1" parent="1" source="p7" target="p8"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="lane1" value="Automated by CloudFormation" style="text;html=1;align=left;fontSize=11;fontStyle=2;fontColor=#545B64;" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lane2" value="People: admin and new engineer" style="text;html=1;align=left;fontSize=11;fontStyle=2;fontColor=#545B64;" vertex="1" parent="1">
          <mxGeometry x="40" y="360" width="300" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
